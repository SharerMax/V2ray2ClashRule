{
  "name": "v2ray2clashrule",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "convert v2ray domain list rule to clash rule",
  "author": "",
  "license": "LGPL-3.0-or-later",
  "keywords": [],
  "main": "src/main.ts",
  "types": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rimraf dist && tsx src/main.ts",
    "dev": "pnpm run typecheck && tsx watch --env-file .env.dev src/main.ts",
    "download": "rimraf data && giget gh:v2fly/domain-list-community/data#master data",
    "dev:render": "ejs src/ejs/index.ejs -f src/ejs/demo.json -o dist/index.html"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "ejs": "^5.0.1",
    "lru-cache": "^11.3.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/debug": "^4.1.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.12.2",
    "eslint": "^10.2.0",
    "giget": "^3.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
